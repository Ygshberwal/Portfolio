---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import Experience from '../components/Experience.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Education from '../components/Education.astro';
import Research from '../components/Research.astro';
import BeyondCode from '../components/BeyondCode.astro';
import PortfolioImage from '../components/PortfolioImage.astro';
import { portraits } from '../data/media';
import { identity, skills } from '../data/portfolio';
import '../styles/scroll.css';
import '../styles/timeline.css';
---
<Base>
  <main id="main">
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-cross" aria-hidden="true">✳</span> SOFTWARE ENGINEER · BENGALURU, INDIA</p>
        <h1 id="hero-title">Complex systems.<br /><em>Clear thinking.</em></h1>
        <p class="hero-description">I'm Yogesh. I build the systems behind useful products—reliable backends, considered interfaces, and thoughtful applications of AI.</p>
        <div class="hero-actions">
          <a class="button" href="#projects">Explore my work <Arrow /></a>
          <a class="text-link resume-link" href={identity.resumeDownload} download="Yogesh_Berwal_Resume.pdf">Download résumé <Arrow diagonal /></a>
        </div>
        <nav class="hero-socials" aria-label="Professional and coding profiles">
          <a href={identity.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow diagonal /></a>
          <a href={identity.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal /></a>
          <a href={identity.leetcode} target="_blank" rel="noopener noreferrer">LeetCode <Arrow diagonal /></a>
          <a href={identity.geeksforgeeks} target="_blank" rel="noopener noreferrer">GeeksforGeeks <Arrow diagonal /></a>
        </nav>
      </div>
      <HeroPortrait />
      <div class="hero-bottom"><span class="micro">BACKEND-FIRST. CURIOUS ACROSS THE STACK.</span><a href="#projects">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
    </section>

    <div class="credentials wrap" aria-label="Professional background">
      <div><span class="micro">PREVIOUSLY</span><p>Amazon <span>SDE Intern</span></p></div>
      <div><span class="micro">FOUNDATION</span><p>IIT Mandi <span>M.Tech CSE '26</span></p></div>
      <div><span class="micro">NOW</span><p>KPI Partners <span>Data Engineer I</span></p></div>
    </div>

    <SelectedWork />

    <Experience />

    <section id="about" class="about-section wrap section" aria-labelledby="about-title">
      <div class="about-layout"><div><p class="eyebrow">03 / THE PERSON BEHIND IT</p><h2 id="about-title">An engineer.<br />Always a <em>student.</em></h2><figure class="profile-photo"><PortfolioImage image={portraits.about} sizes="(max-width: 760px) 230px, 260px" /><figcaption>Yogesh Berwal <span>Bengaluru, India</span></figcaption></figure></div><div class="about-copy"><p class="large-copy">I like understanding how things fit together. Then making them work.</p><p>I'm a computer science postgraduate from IIT Mandi, working across backend systems, data, and product interfaces. My internship at Amazon gave me a closer look at what reliable services demand: careful trade-offs, clear communication, and a lot of testing.</p><p>Outside work, I build things for needs I recognize. A better way to organize my day. A less fragmented parking workflow. A language-modeling problem that isn't easily solved.</p><p>I care about the details between an idea and something someone can actually use.</p><a class="text-link" href="#beyond-code">Away from the keyboard <Arrow /></a></div></div>
      <div class="skills-heading"><h3>Tools I use to build and ship</h3><span class="micro">DIFFERENT TOOLS. DIFFERENT DEPTHS OF EXPERIENCE.</span></div>
      <div class="skills-grid">{skills.map((group, index) => <div class="skill-group"><span class="micro">0{index + 1}</span><h4>{group.title}</h4><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
    </section>

    <Education />
    <Research />
    <BeyondCode />

    <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="wrap"><p class="eyebrow">07 / WHAT'S NEXT?</p><h2 id="contact-title">Have something<br /><em>worth building?</em></h2><div class="contact-bottom"><p>I'm interested in software engineering roles and collaborations.<br />If you're working on an interesting problem, let's talk.</p><a class="contact-email" href={`mailto:${identity.email}`}>{identity.email} <Arrow diagonal /></a></div><div class="contact-profile-links"><a href={identity.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <Arrow diagonal /></a><a href={identity.resumeDownload} download="Yogesh_Berwal_Resume.pdf">Download résumé <Arrow diagonal /></a><a href={identity.github} target="_blank" rel="noopener noreferrer">Explore GitHub <Arrow diagonal /></a></div><p class="micro contact-location">BENGALURU, INDIA · OPEN TO A GOOD CONVERSATION</p></div></section>
  </main>
</Base>

<script>
  import { initializeScrollExperience } from '../scripts/scroll-experience';
  import { initializeTimelineIndicators } from '../scripts/timeline-indicator';
  initializeScrollExperience();
  const disposeTimelines = initializeTimelineIndicators();
  window.addEventListener('pagehide', event => {
    if (!event.persisted) disposeTimelines();
  }, { once: true });
</script>
