---
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import ProjectActions from '../../components/ProjectActions.astro';
import { projectImages } from '../../data/media';
import Arrow from '../../components/Arrow.astro';
import { projects, type Project } from '../../data/portfolio';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } })); }
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const repo = `https://github.com/Ygshberwal/${project.repo}`;
const next = projects[(index + 1) % projects.length];
---
<Base title={`${project.title} — Yogesh Berwal`} description={project.summary}>
  <main id="main" class="wrap case-study section">
    <a class="text-link" href="/work/">← All projects</a>
    <header class="case-heading">
      <p class="eyebrow">PROJECT {String(index + 1).padStart(2, '0')} / {project.category}</p>
      <h1>{project.title}</h1>
      <p class="case-subtitle">{project.subtitle}</p>
      <ul class="tags">{project.stack.map(item => <li>{item}</li>)}</ul>
      <ProjectActions project={project} primary />
      {project.demo && <p class="demo-note">{project.demo.note}</p>}
    </header>
    {projectImages[project.slug] ? <ProjectGallery slug={project.slug} /> : <ProjectCover project={project} index={index} />}
    {project.ownerStory && <aside class="owner-story" aria-label="Why I built this"><span class="micro">WHY I KEPT BUILDING</span><p>{project.ownerStory}</p></aside>}
    {project.paper && <div class="paper-callout"><p>Presented & accepted at MBCC · IIT Mandi · May 2026<br /><span>Publication pending</span></p><a class="text-link" href={project.paper} target="_blank" rel="noopener noreferrer">Read manuscript <Arrow diagonal /></a></div>}
    <div class="case-body"><aside><p class="micro">INSIDE THE PROJECT</p><nav aria-label="Case study sections"><a href="#problem">01 / The problem</a><a href="#approach">02 / The approach</a><a href="#decisions">03 / Engineering notes</a><a href="#scope">04 / Scope & limitations</a><a href="#source">05 / In the source</a></nav></aside><div class="case-content"><section id="problem"><p class="eyebrow">01 / CONTEXT</p><h2>The problem.</h2><p>{project.problem}</p></section><section id="approach"><p class="eyebrow">02 / IMPLEMENTATION</p><h2>What I built.</h2><p>{project.approach}</p></section><section id="decisions"><p class="eyebrow">03 / ENGINEERING NOTES</p><h2>A closer look.</h2>{project.decisions.map(decision => <article class="decision"><h3>{decision.title}</h3><p>{decision.text}</p></article>)}</section><section id="scope" class="scope-note"><p class="eyebrow">04 / SCOPE & LIMITATIONS</p><h2>Where it stands.</h2><p>{project.limitation}</p></section><section id="source"><p class="eyebrow">05 / FOLLOW THE CODE</p><h2>In the source.</h2><p>These are useful starting points in the public repository.</p><ul class="evidence-links">{project.evidence.map(evidence => <li><a href={`${repo}/tree/main/${evidence.path}`} target="_blank" rel="noopener noreferrer"><span>{evidence.label}<small>{evidence.path}</small></span><Arrow diagonal /></a></li>)}</ul></section></div></div>
    <a class="next-project" href={`/work/${next.slug}/`}><span><span class="micro">NEXT PROJECT</span><strong>{next.title}</strong></span><Arrow /></a>
  </main>
</Base>
