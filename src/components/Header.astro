---
import Arrow from './Arrow.astro';
import { identity } from '../data/portfolio';
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Yogesh Berwal, home"><span class="monogram" aria-hidden="true">yb<span>.</span></span><span>Yogesh Berwal</span></a>
  <nav aria-label="Main navigation">
    <a href="/#projects">Work</a><a href="/#experience">Experience</a><a href="/#about">About</a><a href="/#education">Education</a><a href="/#research">Research</a>
  </nav>
  <a class="header-contact header-resume" href={identity.resumeDownload} download="Yogesh_Berwal_Resume.pdf">Résumé <Arrow diagonal /></a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menu <span aria-hidden="true">+</span></button>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <a href="/#projects">Selected work</a><a href="/#experience">Experience</a><a href="/#about">About me</a><a href="/#education">Education</a><a href="/#research">Research</a><a href={identity.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={identity.resumeDownload} download="Yogesh_Berwal_Resume.pdf">Download résumé ↓</a><a href="/#contact">Get in touch</a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    if (menu) menu.hidden = true;
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu(); toggle.focus();
    }
  });
  matchMedia('(min-width: 761px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
</script>
