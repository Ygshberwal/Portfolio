---
import type { Project } from '../data/portfolio';
import Arrow from './Arrow.astro';
interface Props { project: Project; primary?: boolean; }
const { project, primary = false } = Astro.props;
---
<div class="project-actions" role="group" aria-label={`${project.title} links`}>
  <a class={primary ? 'button' : 'text-link'} href={`https://github.com/Ygshberwal/${project.repo}`} target="_blank" rel="noopener noreferrer">View source <Arrow diagonal /></a>
  {project.live && <a class="text-link" href={project.live} target="_blank" rel="noopener noreferrer">Live demo <Arrow diagonal /></a>}
  {project.backend && <a class="text-link" href={project.backend} target="_blank" rel="noopener noreferrer">Backend <Arrow diagonal /></a>}
  {project.certificate && <a class="text-link" href={project.certificate} target="_blank" rel="noopener noreferrer">Certificate <Arrow diagonal /></a>}
  {project.play && <a class="text-link" href={project.play} target="_blank" rel="noopener noreferrer">Play game <Arrow diagonal /></a>}
</div>
