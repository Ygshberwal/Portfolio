---
import type { PortfolioImage } from '../data/media';

interface Props {
  image: PortfolioImage;
  sizes?: string;
  class?: string;
  priority?: boolean;
}
const { image, sizes = '(max-width: 760px) 90vw, 50vw', class: className, priority = false } = Astro.props;
---
<img
  src={`/images/${image.base}-${image.variants.at(-1)}.webp`}
  srcset={image.variants.map(width => `/images/${image.base}-${width}.webp ${width}w`).join(', ')}
  sizes={sizes}
  width={image.width}
  height={image.height}
  alt={image.alt}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
/>
